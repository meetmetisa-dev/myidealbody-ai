# Runtime
APP_ENV=development
DEBUG=true
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
# Entire multipart request limit, enforced before Starlette parses/spools the upload.
MAX_REQUEST_BODY_BYTES=11534336
MAX_IMAGE_PIXELS=25000000

# The bundled mock is offline and always returns the same demo plate.
VISION_PROVIDER=mock

# Use an OpenAI-compatible vision endpoint (for example a separately hosted VLM).
# Never commit an API key. Images are resized before they leave this service.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen2.5-vl:7b
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
# Production-only escape hatch for loopback/RFC1918/.local/.internal VLM hosts.
# Prefer TLS; never enable this for a public hostname or public IP.
ALLOW_INSECURE_PRIVATE_VLM_HTTP=false

# Optional normalized catalog. If unset, approximate bundled demo values are used.
# Production imports should retain per-record provenance and authorized licenses.
NUTRITION_CATALOG_PATH=

# Optional Google Play server-side verification. Disabled securely by default.
BILLING_ENABLED=false
BILLING_INTERNAL_BEARER_TOKEN=
GOOGLE_PLAY_PACKAGE_NAME=com.myidealbody.ai
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/google-play-service-account.json
GOOGLE_PLAY_PRODUCT_IDS=myidealbody_pro_monthly,myidealbody_pro_annual
