#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.14.4
GRADLE_SHA256=f1771298a70f6db5a29daf62378c4e18a17fc33c9ba6b14362e0cdf40610380d
GRADLE_CACHE_ROOT=${GRADLE_USER_HOME:-"${XDG_CACHE_HOME:-$HOME/.cache}/gradle"}
GRADLE_DIR="$GRADLE_CACHE_ROOT/manual-dists/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_DIR/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  ARCHIVE="$GRADLE_CACHE_ROOT/manual-dists/gradle-$GRADLE_VERSION-bin.zip"
  mkdir -p "$GRADLE_CACHE_ROOT/manual-dists"
  if [ ! -f "$ARCHIVE" ]; then
    URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    if command -v curl >/dev/null 2>&1; then
      curl --fail --location --retry 3 --output "$ARCHIVE" "$URL"
    elif command -v wget >/dev/null 2>&1; then
      wget --output-document="$ARCHIVE" "$URL"
    else
      echo "Install Gradle $GRADLE_VERSION, curl, or wget." >&2
      exit 1
    fi
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(sha256sum "$ARCHIVE" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(shasum -a 256 "$ARCHIVE" | awk '{print $1}')
  else
    echo "sha256sum or shasum is required to verify Gradle." >&2
    exit 1
  fi
  if [ "$ACTUAL_SHA256" != "$GRADLE_SHA256" ]; then
    echo "Gradle archive checksum verification failed." >&2
    exit 1
  fi
  command -v unzip >/dev/null 2>&1 || {
    echo "unzip is required to bootstrap Gradle." >&2
    exit 1
  }
  unzip -q -o "$ARCHIVE" -d "$GRADLE_CACHE_ROOT/manual-dists"
fi

cd "$SCRIPT_DIR"
exec "$GRADLE_BIN" "$@"
